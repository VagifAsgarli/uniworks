<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>Yellowstone</name>
		<uuid>7d3f4b52-0796-4a4c-9e1b-251a0d047e01</uuid>
		<vendor>RTU DE0796 T4L, Vagif Asgarli</vendor>
		<product version="1.0" lang="en">yellowstone_model.py (XMILE 1.0 for STELLA)</product>
	</header>
	<sim_specs method="Euler" time_units="Years">
		<start>1995</start>
		<stop>2045</stop>
		<dt>0.25</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="Wolves">
				<doc>Wolves living in the park. The run starts in 1995 with the wolves that were released.</doc>
				<eqn>Wolves_released</eqn>
				<inflow>wolf_births</inflow>
				<outflow>wolf_deaths</outflow>
				<non_negative/>
				<units>wolves</units>
			</stock>
			<stock name="Deers">
				<doc>Deers (elk) of the northern Yellowstone herd, the main prey of the wolves.</doc>
				<eqn>Initial_deers</eqn>
				<inflow>deer_births</inflow>
				<outflow>deer_deaths</outflow>
				<outflow>predation</outflow>
				<non_negative/>
				<units>deers</units>
			</stock>
			<stock name="Vegetation">
				<doc>Condition of the willow, aspen and cottonwood stands, in percent of what the land can carry (100 = full).</doc>
				<eqn>Initial_vegetation</eqn>
				<inflow>regrowth</inflow>
				<outflow>browsing</outflow>
				<non_negative/>
				<units>percent</units>
			</stock>
			<stock name="Beavers">
				<doc>Beaver colonies on the streams of the northern range.</doc>
				<eqn>Initial_beaver_colonies</eqn>
				<inflow>colony_growth</inflow>
				<outflow>colony_loss</outflow>
				<non_negative/>
				<units>colonies</units>
			</stock>
			<flow name="wolf births">
				<doc>Pups that survive their first year: the more deers the packs kill, the more pups they raise.</doc>
				<eqn>Wolves_born_per_deer_eaten*predation</eqn>
				<non_negative/>
				<units>wolves/year</units>
			</flow>
			<flow name="wolf deaths">
				<doc>Wolves dying of age, of fights between packs and diseases (more when the wolves are many) and shot by people.</doc>
				<eqn>Wolves*(Wolf_death_rate+Pack_fights_and_diseases+Wolf_hunting_rate)</eqn>
				<non_negative/>
				<units>wolves/year</units>
			</flow>
			<flow name="deer births">
				<doc>Calves that survive: fewer when the herd is close to the number the land can feed.</doc>
				<eqn>Deer_birth_rate*Deers*MAX(0, 1-Deers/Deer_capacity)</eqn>
				<non_negative/>
				<units>deers/year</units>
			</flow>
			<flow name="deer deaths">
				<doc>Deers dying of age and hunger in winter, killed by bears and cougars, and shot by hunters.</doc>
				<eqn>Deers*(Deer_death_rate*Winter_severity+Bears_and_cougars_rate+Deer_hunting_rate)</eqn>
				<non_negative/>
				<units>deers/year</units>
			</flow>
			<flow name="predation">
				<doc>Deers killed by wolves in a year.</doc>
				<eqn>Kill_coefficient*Wolves*Deers</eqn>
				<non_negative/>
				<units>deers/year</units>
			</flow>
			<flow name="regrowth">
				<doc>New growth of willow and aspen: slows down near 100 percent, faster where beaver ponds raise the water table.</doc>
				<eqn>Vegetation_growth_rate*Vegetation*MAX(0, 1-Vegetation/100)*Beaver_ponds_effect</eqn>
				<non_negative/>
				<units>percent/year</units>
			</flow>
			<flow name="browsing">
				<doc>Young willow and aspen eaten by the deers.</doc>
				<eqn>Browsing_per_1000_deers*Vegetation*Deers/1000</eqn>
				<non_negative/>
				<units>percent/year</units>
			</flow>
			<flow name="colony growth">
				<doc>New beaver colonies: beavers settle where tall willow gives food and dam material and the stream is free.</doc>
				<eqn>Beaver_growth_rate*Beavers*Free_habitat</eqn>
				<non_negative/>
				<units>colonies/year</units>
			</flow>
			<flow name="colony loss">
				<doc>Colonies abandoned in a year.</doc>
				<eqn>Beavers*Beaver_loss_rate</eqn>
				<non_negative/>
				<units>colonies/year</units>
			</flow>
			<aux name="Wolves released">
				<doc>Wolves brought to the park at the start (31 were released in 1995-1996). 0 = no reintroduction.</doc>
				<eqn>31</eqn>
				<range min="0" max="100"/>
				<units>wolves</units>
			</aux>
			<aux name="Wolves born per deer eaten">
				<doc>Surviving pups per deer killed by the packs.</doc>
				<eqn>0.032</eqn>
				<units>wolves/deers</units>
			</aux>
			<aux name="Wolf death rate">
				<doc>Share of the wolves dying in a year when the wolves are few.</doc>
				<eqn>0.15</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Strife coefficient">
				<doc>Extra death rate for every wolf living in the park.</doc>
				<eqn>0.0012</eqn>
				<units>1/wolves/year</units>
			</aux>
			<aux name="Pack fights and diseases">
				<doc>Extra death rate from fights between packs and from diseases; grows with the number of wolves.</doc>
				<eqn>Strife_coefficient*Wolves</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Wolf hunting rate">
				<doc>Share of the wolves shot by people in a year (0 inside the park).</doc>
				<eqn>0</eqn>
				<range min="0" max="0.3"/>
				<units>1/year</units>
			</aux>
			<aux name="Initial deers">
				<doc>Deers at the start: about 17,000 were counted when the wolves came back in 1995.</doc>
				<eqn>17000</eqn>
				<units>deers</units>
			</aux>
			<aux name="Kill coefficient">
				<doc>Share of the herd one wolf kills in a year (0.0012 of 17,000 deers = 20 deers per wolf per year).</doc>
				<eqn>0.0012</eqn>
				<units>1/wolves/year</units>
			</aux>
			<aux name="Deer birth rate">
				<doc>Surviving calves per deer in a year when food is plentiful.</doc>
				<eqn>0.3</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Deer capacity">
				<doc>Deers the land can feed: the grassland plus the willow and aspen browse.</doc>
				<eqn>Grassland_capacity+Browse_capacity_gain*Vegetation/100</eqn>
				<units>deers</units>
			</aux>
			<aux name="Grassland capacity">
				<doc>Deers the grassland alone can feed.</doc>
				<eqn>25250</eqn>
				<units>deers</units>
			</aux>
			<aux name="Browse capacity gain">
				<doc>Extra deers fed when the willow and aspen stands are at 100 percent.</doc>
				<eqn>8000</eqn>
				<units>deers</units>
			</aux>
			<aux name="Deer death rate">
				<doc>Share of the deers dying of age and hunger in a normal winter.</doc>
				<eqn>0.04</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Winter severity">
				<doc>1 = normal winter; 2 = twice as many deers die of cold and hunger.</doc>
				<eqn>1</eqn>
				<range min="0.5" max="3"/>
				<units>1</units>
			</aux>
			<aux name="Bears and cougars rate">
				<doc>Share of the deers killed by bears and cougars in a year.</doc>
				<eqn>0.02</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Deer hunting rate">
				<doc>Share of the herd shot by hunters outside the park in a year.</doc>
				<eqn>0.05</eqn>
				<range min="0" max="0.2"/>
				<units>1/year</units>
			</aux>
			<aux name="Initial vegetation">
				<doc>Condition of the willow and aspen stands at the start: heavily browsed.</doc>
				<eqn>20</eqn>
				<units>percent</units>
			</aux>
			<aux name="Vegetation growth rate">
				<doc>Regrowth per year when the stands are far below 100 percent.</doc>
				<eqn>0.35</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Browsing per 1000 deers">
				<doc>Share of the vegetation eaten in a year by 1,000 deers.</doc>
				<eqn>0.0165</eqn>
				<units>1/deers/year</units>
			</aux>
			<aux name="Initial beaver colonies">
				<doc>Beaver colonies at the start: one colony was found on the northern range in 1996.</doc>
				<eqn>1</eqn>
				<units>colonies</units>
			</aux>
			<aux name="Beaver growth rate">
				<doc>New colonies per colony in a year where tall willow is everywhere and the streams are free.</doc>
				<eqn>2</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Willow habitat">
				<doc>Share of the streams with willow tall enough for beavers (0 to 1).</doc>
				<eqn>MAX(0, (Vegetation-Willow_threshold)/(100-Willow_threshold))</eqn>
				<units>1</units>
			</aux>
			<aux name="Willow threshold">
				<doc>Vegetation condition below which no stream can hold a colony.</doc>
				<eqn>15</eqn>
				<units>percent</units>
			</aux>
			<aux name="Free habitat">
				<doc>Share of the streams with tall willow that no colony occupies yet.</doc>
				<eqn>MAX(0, Willow_habitat-Beavers/Beaver_capacity)</eqn>
				<units>1</units>
			</aux>
			<aux name="Beaver capacity">
				<doc>Colonies the streams of the northern range can hold.</doc>
				<eqn>30</eqn>
				<units>colonies</units>
			</aux>
			<aux name="Beaver loss rate">
				<doc>Share of the colonies abandoned in a year.</doc>
				<eqn>0.05</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Beaver ponds effect">
				<doc>Faster regrowth where beaver ponds raise the water table (1 = no beavers).</doc>
				<eqn>1+Beaver_effect*Beavers/Beaver_capacity</eqn>
				<units>1</units>
			</aux>
			<aux name="Beaver effect">
				<doc>Extra regrowth when the beavers are at their capacity.</doc>
				<eqn>0.3</eqn>
				<units>1</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
