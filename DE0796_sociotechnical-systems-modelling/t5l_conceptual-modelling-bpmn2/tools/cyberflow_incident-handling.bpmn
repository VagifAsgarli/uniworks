<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CyberFlow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="build_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_CyberFlow">
    <bpmn:participant id="Pool_Org" name="Organisation (essential entity)" processRef="Process_Org" />
    <bpmn:participant id="Pool_CSIRT" name="CSIRT (CERT.LV)" processRef="Process_CSIRT" />
    <bpmn:messageFlow id="M1" name="Early warning" sourceRef="T11" targetRef="CS1" />
    <bpmn:messageFlow id="M2" name="Feedback and guidance" sourceRef="C2" targetRef="ME1" />
    <bpmn:messageFlow id="M3" name="Incident notification" sourceRef="T13" targetRef="CS2" />
    <bpmn:messageFlow id="M4" name="Final report" sourceRef="T16" targetRef="CS3" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_Models" name="Procedure models (CyberFlow repository)" />
  <bpmn:process id="Process_Org" name="Organisation (essential entity)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_Org">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT operations">
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SOC" name="SOC analyst">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM" name="Cybersecurity manager (CISO)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ME1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Suspicious activity noticed">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Report the suspicious event">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="Register and classify the event">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D1"><bpmn:targetRef>DO1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T5" name="Handle as a routine event">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Routine event closed">
      <bpmn:incoming>F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="G2">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T10" name="Collect and preserve evidence">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D4"><bpmn:targetRef>DO2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="G3">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T12" name="Prepare the initial assessment">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D5"><bpmn:targetRef>DO3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T4" name="Assess the significance">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:property id="Property_T4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="D2"><bpmn:sourceRef>DO1</bpmn:sourceRef><bpmn:targetRef>Property_T4</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Significant incident?">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T6" name="Activate the incident procedure">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:property id="Property_T6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="D3"><bpmn:sourceRef>DS1a</bpmn:sourceRef><bpmn:targetRef>Property_T6</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="TE1" name="Time limit: 24 h after becoming aware">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_TE1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T11" name="Send the early warning">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ME1" name="Feedback and guidance received">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_ME1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TE2" name="Time limit: 72 h after becoming aware">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_TE2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T13" name="Send the incident notification">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:property id="Property_T13" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="D6"><bpmn:sourceRef>DO3</bpmn:sourceRef><bpmn:targetRef>Property_T13</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T15" name="Review and update the procedure model">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D7"><bpmn:targetRef>DS1b</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="TE3" name="Time limit: one month after the notification">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_TE3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T16" name="Prepare and send the final report">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D8"><bpmn:targetRef>DO4</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Incident closed">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:inclusiveGateway id="G4" name="Which measures are needed?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="T7" name="Isolate the affected systems">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="Block accounts and addresses">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T9" name="Switch to backup systems">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="G5">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="T14" name="Remove the cause, restore services">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="DO1" name="Incident ticket" dataObjectRef="DataObject_DO1" />
    <bpmn:dataObject id="DataObject_DO1" />
    <bpmn:dataStoreReference id="DS1a" name="Procedure models" dataStoreRef="DataStore_Models" />
    <bpmn:dataObjectReference id="DO2" name="Evidence package" dataObjectRef="DataObject_DO2" />
    <bpmn:dataObject id="DataObject_DO2" />
    <bpmn:dataObjectReference id="DO3" name="Initial assessment" dataObjectRef="DataObject_DO3" />
    <bpmn:dataObject id="DataObject_DO3" />
    <bpmn:dataStoreReference id="DS1b" name="Procedure models" dataStoreRef="DataStore_Models" />
    <bpmn:dataObjectReference id="DO4" name="Final report" dataObjectRef="DataObject_DO4" />
    <bpmn:dataObject id="DataObject_DO4" />
    <bpmn:sequenceFlow id="F01" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F03" sourceRef="T2" targetRef="T4" />
    <bpmn:sequenceFlow id="F04" sourceRef="T4" targetRef="G1" />
    <bpmn:sequenceFlow id="F05" name="No" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="F06" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F07" name="Yes" sourceRef="G1" targetRef="T6" />
    <bpmn:sequenceFlow id="F08" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="F09" sourceRef="G2" targetRef="G4" />
    <bpmn:sequenceFlow id="F10" sourceRef="G2" targetRef="T10" />
    <bpmn:sequenceFlow id="F11" sourceRef="G2" targetRef="TE1" />
    <bpmn:sequenceFlow id="F12" sourceRef="G4" targetRef="T7" />
    <bpmn:sequenceFlow id="F13" sourceRef="G4" targetRef="T8" />
    <bpmn:sequenceFlow id="F14" sourceRef="G4" targetRef="T9" />
    <bpmn:sequenceFlow id="F15" sourceRef="T7" targetRef="G5" />
    <bpmn:sequenceFlow id="F16" sourceRef="T8" targetRef="G5" />
    <bpmn:sequenceFlow id="F17" sourceRef="T9" targetRef="G5" />
    <bpmn:sequenceFlow id="F18" sourceRef="TE1" targetRef="T11" />
    <bpmn:sequenceFlow id="F19" sourceRef="T11" targetRef="ME1" />
    <bpmn:sequenceFlow id="F20" sourceRef="G5" targetRef="G3" />
    <bpmn:sequenceFlow id="F21" sourceRef="T10" targetRef="G3" />
    <bpmn:sequenceFlow id="F22" sourceRef="ME1" targetRef="G3" />
    <bpmn:sequenceFlow id="F23" sourceRef="G3" targetRef="T12" />
    <bpmn:sequenceFlow id="F24" sourceRef="T12" targetRef="TE2" />
    <bpmn:sequenceFlow id="F25" sourceRef="TE2" targetRef="T13" />
    <bpmn:sequenceFlow id="F26" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F27" sourceRef="T14" targetRef="T15" />
    <bpmn:sequenceFlow id="F28" sourceRef="T15" targetRef="TE3" />
    <bpmn:sequenceFlow id="F29" sourceRef="TE3" targetRef="T16" />
    <bpmn:sequenceFlow id="F30" sourceRef="T16" targetRef="E2" />
  </bpmn:process>
  <bpmn:process id="Process_CSIRT" name="CSIRT (CERT.LV)" isExecutable="false">
    <bpmn:startEvent id="CS1" name="Early warning received">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_CS1" />
    </bpmn:startEvent>
    <bpmn:task id="C1" name="Register and assess the early warning">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C2" name="Send feedback and guidance">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="CS2" name="Incident notification received">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_CS2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C3" name="Assess the incident notification">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="CS3" name="Final report received">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_CS3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="C4" name="Evaluate the final report, close the case">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="CE" name="Case closed">
      <bpmn:incoming>F37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F31" sourceRef="CS1" targetRef="C1" />
    <bpmn:sequenceFlow id="F32" sourceRef="C1" targetRef="C2" />
    <bpmn:sequenceFlow id="F33" sourceRef="C2" targetRef="CS2" />
    <bpmn:sequenceFlow id="F34" sourceRef="CS2" targetRef="C3" />
    <bpmn:sequenceFlow id="F35" sourceRef="C3" targetRef="CS3" />
    <bpmn:sequenceFlow id="F36" sourceRef="CS3" targetRef="C4" />
    <bpmn:sequenceFlow id="F37" sourceRef="C4" targetRef="CE" />
  </bpmn:process>
